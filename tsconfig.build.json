{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Declaration-only emit. Bun executes TypeScript natively, so `src/` ships
    // as-is and this build produces nothing but type declarations for editors
    // and `tsc` consumers. Inherits `moduleResolution: "bundler"` from the base
    // config, which is what Bun itself uses — no NodeNext, no `.js` extensions.
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "outDir": "./types",
    "rootDir": "./src"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "types", "tests"]
}
