{
  "name": "bun-qr",
  "version": "0.2.0",
  "description": "QR code generator with link encoding utilities for Bun runtime",
  "license": "(MIT OR Apache-2.0)",
  "repository": { "type": "git", "url": "git+https://github.com/cipher-rc5/bun-qr.git" },
  "homepage": "https://github.com/cipher-rc5/bun-qr#readme",
  "bugs": { "url": "https://github.com/cipher-rc5/bun-qr/issues" },
  "keywords": ["qr", "qrcode", "bun", "encoder", "svg", "gif", "zero-dependency"],
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "types/index.d.ts",
  "bin": { "bun-qr": "./src/cli.ts" },
  "type": "module",
  "scripts": {
    "build": "bunx tsc --project tsconfig.build.json",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "qr": "bun run ./src/cli.ts",
    "bench": "bun run tests/benchmark.ts",
    "fmt": "bunx dprint fmt",
    "fmt:check": "bunx dprint check",
    "postinstall": "test -f dprint.json && bun run fmt || true",
    "prepublishOnly": "bun run fmt:check && bun run typecheck && bun test && bun run build"
  },
  "exports": {
    ".": { "types": "./types/index.d.ts", "bun": "./src/index.ts", "default": "./src/index.ts" },
    "./links": { "types": "./types/links.d.ts", "bun": "./src/links.ts", "default": "./src/links.ts" }
  },
  "files": [
    "src",
    "types",
    "!src/decode.ts",
    "!src/dom.ts",
    "!types/decode.d.ts*",
    "!types/dom.d.ts*",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "LICENSE-MIT"
  ],
  "engines": { "bun": ">=1.3.0" },
  "devDependencies": { "@types/bun": "1.3.14", "typescript": "7.0.2" },
  "peerDependencies": { "typescript": ">=5.0.0" },
  "peerDependenciesMeta": { "typescript": { "optional": true } }
}
